const total = AREAS.reduce((n, a) => n + a.photos.length, 0);
---

<Layout title="Photo Baseline — Garden">
  <div class="animate-in">
    <div class="mb-10">
      <p class="font-medium text-terra uppercase tracking-widest text-sm mb-1">End-of-winter baseline &middot; 6 August 2026</p>
      <h1 class="text-4xl font-semibold mb-2">Winter Photo Baseline</h1>
      <p class="text-ink-soft max-w-2xl">
        All {total} photos from the winter sweep — the &ldquo;before&rdquo; set for spring comparison (shoot the &ldquo;after&rdquo; set Nov&ndash;Dec).
        Every plant ID is settled; details live on each plant&rsquo;s page.
      </p>
    </div>

    {AREAS.map((area) => (
      <section class="mb-14">
        <h2 class="font-display text-3xl font-semibold mb-5 pb-2 border-b border-rule">{area.title}</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          {area.photos.map((p) => (
            <figure class="bg-paper rounded-xl border border-rule overflow-hidden flex flex-col">
              <a href={`/images/winter-2026/${p.img}.jpg`} target="_blank" class="block relative" style="aspect-ratio: 4/3;">
                <img
                  src={`/images/winter-2026/${p.img}.jpg`}
                  alt={p.ids.join(', ')}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              </a>
              <figcaption class="px-4 py-3 flex-1 flex flex-col gap-2">
                <span class="font-mono text-sm text-ink-faint">{p.img}</span>
                <div class="flex flex-wrap gap-1.5">
                  {p.ids.map((id) => (
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-olive/10 text-olive">{id}</span>
                  ))}
                </div>
                {p.note && <p class="text-[0.92rem] text-ink-soft">{p.note}</p>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
