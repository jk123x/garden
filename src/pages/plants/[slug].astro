---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { MONTH_NAMES_SHORT, CATEGORY_LABELS, CATEGORY_COLORS, TYPE_LABELS, getCurrentMonth } from '../../lib/utils';
import { todayFrom, attentionChip, isWaiting } from '../../lib/schedule';
import { resolveImage } from '../../lib/images';
import HealthBadge from '../../components/HealthBadge.astro';
import Photo from '../../components/Photo.astro';

export async function getStaticPaths() {
  const plants = await getCollection('plants');
  return plants.map((plant) => ({
    params: { slug: plant.id },
    props: { plant },
  }));
}

const { plant } = Astro.props;
const { name, type, indoor, location, zones, health, healthStatus, lastAssessed, image, photos, notes, tasks, log, urgency, nextAction } = plant.data;
const currentMonth = getCurrentMonth();
const today = todayFrom();

const chip = urgency && urgency !== 'later' ? attentionChip(plant.data, today) : null;
const waiting = isWaiting(plant.data, today);
const CHIP_CLASS = { urgent: 'bg-amber-50 text-amber-700', late: 'bg-red-50 text-red-700', muted: 'bg-stone-100 text-stone-500' };

// Gallery thumbnails are resized; the click-through opens a 1600px copy.
const gallery = await Promise.all(
  photos.map(async (photo: { src: string; caption?: string }) => {
    const meta = await resolveImage(photo.src);
    const large = meta ? await getImage({ src: meta, width: 1600, format: 'jpg', quality: 78 }) : null;
    return { ...photo, large: large?.src ?? photo.src };
  }),
);

const logEntries = [...log].sort((a, b) => b.date.localeCompare(a.date));
const LAST_DONE = ['mulch', 'feed', 'prune', 'spray'];
const lastDone = LAST_DONE.map((c) => ({ c, date: logEntries.find((e) => e.category === c)?.date })).filter((x) => x.date);

const tasksByMonth = Array.from({ length: 12 }, (_, i) => {
  const month = i + 1;
  return {
    month,
    name: MONTH_NAMES_SHORT[i],
    tasks: tasks.filter((t: { months: number[] }) => t.months.includes(month)),
    isCurrent: month === currentMonth,
  };
});
---

<Layout title={`${name} — Garden`}>
  <div class="animate-in space-y-10">
    <div>
      <a href="/plants" class="text-sm text-terra hover:text-terra/80 font-medium transition-colors">&larr; All plants</a>

      {image ? (
        <div class="mt-5 flex flex-col md:flex-row gap-8">
          <div class="md:flex-1">
            <h1 class="text-5xl font-semibold text-ink tracking-tight">{name}</h1>
            <div class="flex flex-wrap items-center gap-2.5 mt-3">
              <span class="bg-rule-light px-2.5 py-1 rounded-md text-xs font-medium text-ink-soft">{TYPE_LABELS[type] || type}</span>
              <span class:list={['px-2.5 py-1 rounded-md text-xs font-medium', indoor ? 'bg-sky-50 text-sky-700' : 'bg-olive-soft text-olive']}>
                {indoor ? 'Indoor' : 'Outdoor'}
              </span>
              <span class="text-ink-faint">{location}</span>
              {zones && zones.length > 0 && (
                <a href="/plants/irrigation" class="bg-sky-50 text-sky-700 px-2.5 py-1 rounded-md text-xs font-medium">Zone {zones.join(' + ')}</a>
              )}
            </div>
            {healthStatus && (
              <div class="flex items-center gap-3 mt-3">
                <HealthBadge status={healthStatus} />
                {lastAssessed && (
                  <span class="text-xs text-ink-faint">Assessed {lastAssessed}</span>
                )}
              </div>
            )}
            {lastDone.length > 0 && (
              <p class="text-xs text-ink-faint mt-2 flex flex-wrap gap-x-3 gap-y-1">
                {lastDone.map(({ c, date }) => (<span>Last {({ mulch: 'mulched', feed: 'fed', prune: 'pruned', spray: 'sprayed' } as Record<string, string>)[c]} <span class="font-semibold text-ink-soft">{date}</span></span>))}
              </p>
            )}
            {health && (
              <p class="text-ink-soft mt-2">{health}</p>
            )}
            {notes && (
              <div class="mt-5 pt-4 border-t border-rule-light/60">
                <p class="text-ink-soft leading-relaxed">{notes}</p>
              </div>
            )}
          </div>
          <div class="md:w-80 shrink-0">
            <Photo
              src={image}
              alt={name}
              widths={[640, 1280]}
              sizes="(min-width: 768px) 20rem, 100vw"
              loading="eager"
              class="w-full h-64 md:h-72 object-cover rounded-xl border border-rule-light shadow-sm"
            />
          </div>
        </div>
      ) : (
        <div class="mt-3">
          <h1 class="text-5xl font-semibold text-ink tracking-tight">{name}</h1>
          <div class="flex flex-wrap items-center gap-2.5 mt-3">
            <span class="bg-rule-light px-2.5 py-1 rounded-md text-xs font-medium text-ink-soft">{TYPE_LABELS[type] || type}</span>
            <span class:list={['px-2.5 py-1 rounded-md text-xs font-medium', indoor ? 'bg-sky-50 text-sky-700' : 'bg-olive-soft text-olive']}>
              {indoor ? 'Indoor' : 'Outdoor'}
            </span>
            <span class="text-ink-faint">{location}</span>
              {zones && zones.length > 0 && (
                <a href="/plants/irrigation" class="bg-sky-50 text-sky-700 px-2.5 py-1 rounded-md text-xs font-medium">Zone {zones.join(' + ')}</a>
              )}
          </div>
          {healthStatus && (
            <div class="flex items-center gap-3 mt-3">
              <HealthBadge status={healthStatus} />
              {lastAssessed && (
                <span class="text-xs text-ink-faint">Assessed {lastAssessed}</span>
              )}
            </div>
          )}
          {health && (
            <p class="text-ink-soft mt-2">{health}</p>
          )}
          {notes && (
            <div class="mt-5 pt-4 border-t border-rule-light/60">
              <p class="text-ink-soft leading-relaxed">{notes}</p>
            </div>
          )}
        </div>
      )}
    </div>

    {nextAction && (
      <section class:list={['bg-paper rounded-xl border border-rule-light border-l-4 p-5', urgency === 'later' || waiting ? 'border-l-stone-300' : 'border-l-olive']}>
        <p class="text-sm font-semibold text-ink mb-2">
          {urgency === 'later' ? "Whenever you're passing" : waiting ? 'Waiting' : 'Do now'}
          {chip && <span class:list={['ml-1.5 align-middle text-[11px] font-semibold rounded px-1.5 py-0.5', CHIP_CLASS[chip.tone]]}>{chip.text}</span>}
        </p>
        <p class="text-ink-soft text-sm leading-relaxed">{nextAction}</p>
      </section>
    )}

    {gallery.length > 0 && (
      <div>
        <h2 class="text-3xl font-semibold text-ink mb-5">Photos</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {gallery.map((photo) => (
            <figure>
              <a href={photo.large} target="_blank" rel="noopener" class="block relative rounded-xl overflow-hidden border border-rule-light shadow-sm" style="aspect-ratio: 4/3;">
                <Photo src={photo.src} alt={photo.caption || name} widths={[400, 800]} sizes="(min-width: 640px) 33vw, 50vw" class="absolute inset-0 w-full h-full object-cover" />
              </a>
              {photo.caption && (
                <figcaption class="text-xs text-ink-faint mt-1.5 leading-snug">{photo.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    )}

    {logEntries.length > 0 && (
      <div>
        <h2 class="text-3xl font-semibold text-ink mb-5">Log</h2>
        <ol class="space-y-4 border-l border-rule-light pl-5">
          {logEntries.map((entry: { date: string; entry: string; category?: string }) => (
            <li class="relative">
              <span class="absolute -left-[27px] top-1.5 w-2.5 h-2.5 rounded-full bg-terra ring-2 ring-paper"></span>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-display font-semibold text-ink">{entry.date}</span>
                {entry.category && (
                  <span class:list={['inline-block px-2 py-0.5 rounded-md text-[10px] font-semibold tracking-wide uppercase', CATEGORY_COLORS[entry.category]]}>
                    {CATEGORY_LABELS[entry.category]}
                  </span>
                )}
              </div>
              <p class="text-ink-soft leading-relaxed mt-1">{entry.entry}</p>
            </li>
          ))}
        </ol>
      </div>
    )}

    <div>
      <h2 class="text-3xl font-semibold text-ink mb-5">Care calendar</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {tasksByMonth.map(({ name: monthName, tasks: monthTasks, isCurrent }) => (
          <div
            class:list={[
              'rounded-xl border p-4 min-h-[110px] transition-all',
              isCurrent
                ? 'border-terra/40 bg-terra-soft ring-1 ring-terra/10'
                : monthTasks.length > 0
                  ? 'border-rule-light bg-paper'
                  : 'border-rule-light/50 bg-parchment/50',
            ]}
          >
            <div class="flex items-center justify-between mb-2.5">
              <span class:list={[
                'font-display font-semibold',
                isCurrent ? 'text-terra' : 'text-ink',
              ]}>
                {monthName}
              </span>
              {isCurrent && (
                <span class="text-[10px] font-semibold uppercase tracking-wider text-terra bg-terra/10 px-1.5 py-0.5 rounded-md">
                  Now
                </span>
              )}
            </div>
            {monthTasks.length > 0 ? (
              <ul class="space-y-2">
                {monthTasks.map((task: { category: string; task: string }) => (
                  <li>
                    <span class:list={['inline-block px-2 py-0.5 rounded-md text-xs font-semibold tracking-wide uppercase', CATEGORY_COLORS[task.category]]}>
                      {CATEGORY_LABELS[task.category]}
                    </span>
                    <span class="text-sm text-ink-soft block mt-1 leading-snug">{task.task}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-xs text-ink-faint italic">Nothing</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
