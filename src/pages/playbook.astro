---
import Layout from '../layouts/layout.astro';

const DUE_DATE = new Date('2026-08-04');
const today = new Date();
const daysLeft = Math.max(0, Math.ceil((DUE_DATE.getTime() - today.getTime()) / 86400000));

const QUICK_HITS = [
  { job: 'Book the feijoa contractor', how: 'One phone call. Any lopper/tree service. Before summer is fine — no fruit fly risk until fruit sets next autumn.' },
  { job: 'Snail bait the copper tub + cutting bed', how: 'The moment the Multiguard arrives: pull straw back from the crowns, scatter pellets, done. Protects the spring shoots on your cut flowers.' },
  { job: 'Osmocote Native on the 8 natives', how: 'The day it arrives: banksia, wattle, kangaroo paw, westringia, cushion bush, chalk sticks, dianellas, native daisies. It waits for warm soil — early costs nothing.' },
  { job: 'A chunk of jasmine ties', how: 'Any 15 minutes: remove ties where the stem has twined onto the wire, cut anything biting bark, loose figure-8 only where still needed. ~75% to go.' },
  { job: 'Scratch-test the east jasmine wall-top', how: 'Thumbnail on the desiccated stems: green underneath = leave, brown-and-snaps = cut it out. 30 seconds in passing.' },
];

const SESSIONS = [
  {
    name: 'The orange session',
    time: '~1 hour',
    gear: 'Secateurs, a bucket, eco-oil (when the order lands)',
    deadline: 'Before the due date — the spray matters most',
    steps: [
      'Pick every ripe orange. The crop is the biggest drain on the tree and it’s ready.',
      'Follow the ant trails to the scale: brown/black bumps on stems and leaf undersides.',
      'Spray the whole tree with eco-oil on a cool dry day — coat the leaf undersides, that’s where scale lives.',
      'While standing there: snip clear galls off this tree and the small citrus next to it. Sausage swellings mid-stem only — anything swollen at a branch fork is normal wood, leave it.',
      'Galled offcuts go in the green bin. Ants still trailing in 3 weeks = repeat the spray.',
    ],
  },
  {
    name: 'The feed lap',
    time: '~1 hour, one walk',
    gear: 'Richgro All Purpose + Experts Choice + Sudden Impact (shed)',
    deadline: 'Early August — last calm weekend before the due date',
    steps: [
      'Full plant-by-plant map lives on the Feeding page — work off that.',
      'Short version: Richgro on beds/climbers/trees listed, light on the delicate ones.',
      'Experts Choice LIGHT on lemon + orange + small citrus. Never the lime.',
      'Sudden Impact over the buffalo.',
      'Skip list is on the Feeding page — lime, feijoa, rosemary, cutting-bed flowers, dusty miller.',
    ],
    link: { href: '/feeding', label: 'Open the Feeding guide →' },
  },
  {
    name: 'The pruning session',
    time: '~1.5 hours',
    gear: 'Secateurs, loppers, pruning saw (all owned)',
    deadline: 'Before the due date — winter windows close with it',
    steps: [
      'Passionfruit: cut the whole vine back by a third. Untangle from the jasmine as you go — 3-lobed leaves = passionfruit, small glossy ovals = jasmine.',
      'Olive: dead/crossing/rubbing branches first, then a few inward-growing ones so light reaches the centre — “a bird could fly through it”. Cut just outside the branch collar, never flush. Suckers off the base. Stop at ~20% of the canopy. Whole branches at their origin, never tip-trims.',
      'Lily turf: shear the clumps along the sleepers to the ground. New growth replaces it all in spring.',
      'Dianella: cut old flower stalks and tatty leaves at the base. Ten minutes.',
    ],
  },
];

const SLIPPABLE = [
  { job: 'Second eco-oil spray on the orange', when: '2–3 weeks after the first. If a newborn makes it week 4, the first spray still did most of the work.' },
  { job: 'Lemon harvest', when: 'As they ripen through Aug–Sept. Casual, bowl at a time. Fruit from galled branches is completely fine to eat.' },
  { job: 'Lemon gall prune', when: 'AFTER the lemons are off, BEFORE end of September — the one hard deadline in the garden. Same rules as the orange session; prunings straight into a bin that’s getting collected.' },
  { job: 'Irrigation back on', when: 'Mid-September. Literally one tap. The single must-do garden action while you’re on baby duty.' },
  { job: 'Nature strip second weeding pass', when: 'Whenever. Taproot puller, the regrowth since the May mow.' },
  { job: 'Remaining jasmine ties', when: 'Whenever, in chunks.' },
];

const DONE = [
  'Lawn: winter grass purged (before seed set)',
  'Lime: renovation prune done — zero jobs until winter 2027',
  'Rosemary: dead half removed',
  'Black eyed susan: cut to ground',
  'All four citrus: Epsom drenched',
  'East jasmines: watered, on schedule',
  'Bartlettina: through winter fine, nothing needed',
  'Supplies: everything ordered or in the shed',
];
---

<Layout title="Playbook — Garden">
  <div class="animate-in">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-medium text-terra uppercase tracking-widest text-sm mb-1">The playbook</p>
        <h1 class="text-4xl font-semibold mb-2">Before the Baby</h1>
        <p class="text-ink-soft max-w-2xl">
          Every remaining job, in order, with the how-to attached. Three sessions, a handful of
          15-minute hits, and a short list that's allowed to slip.
        </p>
      </div>
      <div class="bg-paper border border-rule rounded-xl px-5 py-3 text-center">
        <p class="font-display text-4xl font-semibold text-terra leading-none">{daysLeft}</p>
        <p class="text-xs uppercase tracking-widest text-ink-faint mt-1">days to due date</p>
      </div>
    </div>

    <!-- Got 15 minutes? -->
    <section class="mb-12">
      <h2 class="font-display text-3xl font-semibold mb-1">Got 15 minutes?</h2>
      <p class="text-ink-soft mb-4">Grab any one of these. No setup, no sequencing.</p>
      <div class="space-y-2.5">
        {QUICK_HITS.map((item) => (
          <div class="bg-paper rounded-lg border border-rule px-4 py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
            <p class="font-semibold whitespace-nowrap">{item.job}</p>
            <p class="text-ink-soft text-[0.95rem]">{item.how}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Got an hour? -->
    <section class="mb-12">
      <h2 class="font-display text-3xl font-semibold mb-1">Got an hour? Do the next session</h2>
      <p class="text-ink-soft mb-4">In this order if possible — but any of them beats none of them.</p>
      <div class="space-y-5">
        {SESSIONS.map((session, i) => (
          <div class="bg-paper rounded-xl border border-rule p-5">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-1">
              <h3 class="font-display text-2xl font-semibold">
                <span class="text-terra mr-1">{i + 1}.</span>{session.name}
              </h3>
              <span class="text-sm text-ink-faint">{session.time}</span>
            </div>
            <p class="text-sm text-ink-soft mb-1"><strong class="font-semibold text-ink">Gear:</strong> {session.gear}</p>
            <p class="text-sm text-terra font-medium mb-3">{session.deadline}</p>
            <ol class="space-y-1.5 list-none">
              {session.steps.map((step, j) => (
                <li class="flex gap-3">
                  <span class="text-ink-faint font-display shrink-0">{j + 1}</span>
                  <span class="text-[0.97rem]">{step}</span>
                </li>
              ))}
            </ol>
            {session.link && (
              <a href={session.link.href} class="inline-block mt-3 font-medium text-terra hover:underline">{session.link.label}</a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Allowed to slip -->
    <section class="mb-12">
      <h2 class="font-display text-3xl font-semibold mb-1">Allowed to slip past the due date</h2>
      <p class="text-ink-soft mb-4">These have real dates, but none of them are pre-baby dates.</p>
      <div class="bg-paper rounded-xl border border-rule divide-y divide-rule-light">
        {SLIPPABLE.map((item) => (
          <div class="px-4 py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
            <p class="font-semibold sm:w-64 shrink-0">{item.job}</p>
            <p class="text-ink-soft text-[0.95rem]">{item.when}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Gall wasp reference -->
    <section class="mb-12 bg-paper rounded-xl border border-rule p-5">
      <h2 class="font-display text-2xl font-semibold mb-3">Gall wasp cheat sheet <span class="text-sm font-body font-medium text-ink-faint">(used in sessions 1 &amp; the lemon job)</span></h2>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-[0.97rem]">
        <p><strong class="font-semibold">Is it a gall?</strong> Sausage-shaped swelling in the <em>middle</em> of a stem, tapering back to normal at both ends. Swelling <em>at a fork</em> where branches meet = normal wood.</p>
        <p><strong class="font-semibold">Old or live?</strong> Tiny pinprick holes = last season's, empty, low priority. Smooth and solid = occupied, cut it.</p>
        <p><strong class="font-semibold">The cut:</strong> 1–2cm below the gall into clean stem. Everything past the cut comes off — check no fruit is hanging beyond it first.</p>
        <p><strong class="font-semibold">Disposal:</strong> green bin that's getting collected, never compost, never an open pile. Cap: a third of any tree's canopy per winter.</p>
        <p><strong class="font-semibold">Fruit safety:</strong> fruit on galled branches is 100% fine — larvae live in stem wood only.</p>
        <p><strong class="font-semibold">The clock:</strong> wasps emerge ~October. All gall cutting done by end of September.</p>
      </div>
    </section>

    <!-- Done -->
    <section class="mb-4">
      <h2 class="font-display text-2xl font-semibold text-ink-soft mb-3">Already handled</h2>
      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-1.5 text-ink-faint text-[0.95rem]">
        {DONE.map((item) => (
          <li class="flex gap-2.5 items-baseline">
            <span class="shrink-0">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
