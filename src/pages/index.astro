---
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';
import { getPlantsNeedingAttention, MONTH_NAMES, CATEGORY_LABELS, CATEGORY_COLORS } from '../lib/utils';
import {
  todayFrom, placeTask, taskChip, deadlineKey, attentionChip, isWaiting,
  type Placement, type Chip, type ChipTone,
} from '../lib/schedule';

const allPlants = await getCollection('plants');
const today = todayFrom();
const currentMonth = today.month;

const outdoorPlants = allPlants.filter((p) => !p.data.indoor);
const indoorPlants = allPlants.filter((p) => p.data.indoor);

const DASHBOARD_HIDDEN_CATEGORIES = ['harvest'];
const CATEGORY_ORDER = ['spray', 'prune', 'feed', 'plant', 'mulch', 'general', 'water'];

// Chip colours by tone; the same map lives in the client script below.
const CHIP_CLASS: Record<ChipTone, string> = {
  urgent: 'bg-amber-50 text-amber-700',
  late: 'bg-red-50 text-red-700',
  muted: 'bg-stone-100 text-stone-500',
};
const CHIP_BASE = 'ml-1.5 align-middle text-[11px] font-semibold rounded px-1.5 py-0.5';
const DOTS: Record<string, string> = { today: 'text-rose-500', week: 'text-amber-500', ongoing: 'text-olive' };

type TaskRow = {
  plantId: string;
  plantName: string;
  months: number[];
  day?: number;
  byDay?: number;
  task: string;
  category: string;
  completed?: string;
};

// Every non-harvest task, all twelve months — the client script places each
// row (Do now / Coming up / hidden) against the real current date,
// so nothing goes stale between deploys.
const taskRowsFor = (plants: typeof allPlants): TaskRow[] =>
  plants
    .flatMap((plant) =>
      plant.data.tasks
        .filter((t) => !DASHBOARD_HIDDEN_CATEGORIES.includes(t.category))
        .map((t) => ({ plantId: plant.id, plantName: plant.data.name, ...t }))
    )
    .sort((a, b) => CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category));

const outdoorAttention = getPlantsNeedingAttention(outdoorPlants, today.iso);
const indoorAttention = getPlantsNeedingAttention(indoorPlants, today.iso);

const isAutumn = currentMonth >= 4 && currentMonth <= 5;

const outdoorPhotosNeeded = outdoorPlants.filter(p => p.data.photoNeeded);
const indoorPhotosNeeded = indoorPlants.filter(p => p.data.photoNeeded);

type TaskGroup = {
  indoor: boolean;
  rows: TaskRow[];
  plantCount: number;
  attention: typeof outdoorAttention;
  photosNeeded: typeof outdoorPhotosNeeded;
};
const groups: TaskGroup[] = [
  { indoor: false, rows: taskRowsFor(outdoorPlants), plantCount: outdoorPlants.length, attention: outdoorAttention, photosNeeded: outdoorPhotosNeeded },
  { indoor: true, rows: taskRowsFor(indoorPlants), plantCount: indoorPlants.length, attention: indoorAttention, photosNeeded: indoorPhotosNeeded },
];

const chipClass = (chip: Chip | null) => (chip ? `${CHIP_BASE} ${CHIP_CLASS[chip.tone]}` : 'hidden');
---

<Layout title="Garden Dashboard">
  {groups.map(({ indoor, rows, plantCount, attention, photosNeeded }) => {
    const placed = (p: Placement) => rows.filter((r) => placeTask(r, today) === p);
    const nowRows = placed('now').sort((a, b) => deadlineKey(a, today) - deadlineKey(b, today));
    const poolRows = rows.filter((r) => placeTask(r, today) !== 'now');

    const renderTaskRow = (row: TaskRow) => {
      const chip = taskChip(row, placeTask(row, today), today);
      return (
      <li
        class="flex gap-3"
        data-task-row
        data-months={row.months.join(',')}
        data-day={row.day}
        data-by-day={row.byDay}
        data-completed={row.completed}
        data-repeat={row.repeat}
      >
        <span class="shrink-0 text-olive">·</span>
        <span class="text-sm">
          <a href={`/plants/${row.plantId}`} class="text-terra hover:text-terra/80 font-medium transition-colors">{row.plantName}</a>
          <span class:list={['ml-1.5 align-middle text-[11px] uppercase tracking-wide font-semibold rounded px-1.5 py-0.5', CATEGORY_COLORS[row.category]]}>
            {CATEGORY_LABELS[row.category]}
          </span>
          <span data-task-chip class={chipClass(chip)}>{chip.text}</span>
          <span class="text-ink-soft"> — {row.task}</span>
        </span>
      </li>
      );
    };

    // Date-blocked items render hidden and the client script reveals each on its date.
    const nowPool = indoor
      ? [...attention.attention, ...attention.waiting]
      : [...attention.attention, ...attention.waiting, ...indoorAttention.attention, ...indoorAttention.waiting];

    const renderItem = (plant: (typeof allPlants)[number]) => {
      const waiting = isWaiting(plant.data, today);
      const chip = attentionChip(plant.data, today);
      return (
        <li
          class="flex gap-3"
          hidden={waiting}
          data-attention-item
          data-urgency={plant.data.urgency}
          data-ready-from={plant.data.readyFrom}
          data-due-by={plant.data.dueBy}
        >
          <span class:list={['shrink-0', DOTS[plant.data.urgency ?? 'ongoing'] ?? 'text-olive']}>·</span>
          <span>
            <a href={`/plants/${plant.id}`} class="text-terra hover:text-terra/80 font-medium transition-colors">{plant.data.name}</a>
            {!indoor && plant.data.indoor && (
              <span class="ml-1.5 align-middle text-[11px] uppercase tracking-wide font-semibold text-olive bg-olive/10 rounded px-1.5 py-0.5">indoor</span>
            )}
            <span data-chip class={chipClass(chip)}>{chip?.text}</span>
            {plant.data.nextAction && <span> — {plant.data.nextAction}</span>}
          </span>
        </li>
      );
    };

    const boxEmpty = attention.attention.length === 0 && nowRows.length === 0;

    return (
    <div data-indoor={String(indoor)} class="animate-in space-y-10" data-dash-group>
      <div>
        <h1 class="text-6xl font-semibold text-ink tracking-tight" data-month-heading>
          {MONTH_NAMES[currentMonth - 1]}
        </h1>
        <p class="text-ink-soft mt-3 text-lg">
          <span data-header-count>{nowRows.length}</span> task{nowRows.length !== 1 ? 's' : ''} due now across {plantCount} plant{plantCount !== 1 ? 's' : ''}
          {attention.attention.length > 0 && (
            <span> · {attention.attention.length} need{attention.attention.length === 1 ? 's' : ''} attention</span>
          )}
        </p>
      </div>

      {!indoor && (
        <section class="hidden bg-paper/60 rounded-xl border border-rule-light px-5 py-4 space-y-2" data-weather>
          <div class="flex items-baseline justify-between gap-4 flex-wrap">
            <p class="text-sm text-ink-soft"><span class="font-semibold text-ink">Melbourne weather</span> · <span data-weather-past></span></p>
            <p class="text-[11px] text-ink-faint" data-weather-updated></p>
          </div>
          <div class="flex gap-2 flex-wrap text-[12px]" data-weather-days></div>
          <p class="text-sm text-ink-soft hidden" data-weather-hint></p>
        </section>
      )}

      <section class:list={['bg-paper rounded-xl border border-rule-light border-l-4 border-l-olive p-5 space-y-4', boxEmpty && 'hidden']} data-todo-box>
        <h2 class="font-display text-lg font-semibold text-ink">To do</h2>
        <div data-now-section class:list={[boxEmpty && 'hidden']}>
          <p class="text-sm font-semibold text-ink mb-2">Do now</p>
          <ul class="space-y-1.5 text-ink-soft text-sm" data-now-list>
            {nowPool.map(renderItem)}
          </ul>
          <ul class="space-y-2 mt-3" data-tasks-now-list>
            {nowRows.map(renderTaskRow)}
          </ul>
        </div>
      </section>

      <div class:list={['bg-paper rounded-xl p-10 text-center border border-rule-light', (nowRows.length > 0 || attention.attention.length > 0) && 'hidden']} data-empty-state>
        <p class="text-ink-faint italic font-display text-lg">Nothing to do right now. Nice.</p>
      </div>

      {photosNeeded.length > 0 && (
        <section class="bg-terra-soft/50 rounded-xl border border-terra/15 p-5">
          <h2 class="font-display text-lg font-semibold text-terra mb-3">Photos needed</h2>
          <ul class="space-y-2.5">
            {photosNeeded.map((plant) => (
              <li class="flex items-start gap-3">
                <a href={`/plants/${plant.id}`} class="text-terra hover:text-terra/80 font-medium transition-colors shrink-0 whitespace-nowrap">
                  {plant.data.name}
                </a>
                <span class="text-sm text-ink-soft">{plant.data.photoNeeded}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {attention.unassessed.length > 0 && (
        <div class="bg-paper/60 rounded-xl border border-rule-light p-5">
          <p class="text-sm font-medium text-ink-soft mb-3">Needs assessment</p>
          <div class="flex flex-wrap gap-2">
            {attention.unassessed.map((plant) => (
              <a
                href={`/plants/${plant.id}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-stone-100 text-sm text-stone-600 hover:bg-stone-200 transition-colors"
              >
                {plant.data.name}
              </a>
            ))}
          </div>
        </div>
      )}

      {indoor && isAutumn && (
        <section class="bg-terra-soft/40 rounded-xl border border-terra/15 p-6">
          <h2 class="text-xl font-semibold text-ink mb-1">
            Indoor autumn care
          </h2>
          <p class="font-display italic text-ink-soft mb-4 text-sm">
            A few things worth doing across the whole indoor collection this month.
          </p>
          <ul class="space-y-1.5 text-ink text-sm">
            <li class="flex gap-3"><span class="text-terra">·</span>Water less often — check soil 2cm down before watering. Cool rooms dry slowly.</li>
            <li class="flex gap-3"><span class="text-terra">·</span>Boost humidity for ferns and Grey Star — pebble trays or group plants.</li>
            <li class="flex gap-3"><span class="text-terra">·</span>Yellow sticky traps for fungus gnats — autumn is peak.</li>
            <li class="flex gap-3"><span class="text-terra">·</span>Wipe dust off broadleaves so they can photosynthesise in low light.</li>
            <li class="flex gap-3"><span class="text-terra">·</span>Shift plants closer to the brightest windows. Daylight drops fast from here.</li>
            <li class="flex gap-3"><span class="text-terra">·</span>Hold off feeding until spring (September) — no growth, no feed.</li>
          </ul>
        </section>
      )}

      {attention.later.length > 0 && (
        <div>
          <h2 class="text-3xl font-semibold text-ink mb-4">Whenever you're passing</h2>
          <div class="bg-paper/60 rounded-xl border border-rule-light p-5">
            <p class="text-ink-faint italic font-display text-sm mb-3">All doable right now, none urgent — grab one if you're already out there with spare minutes.</p>
            <ul class="space-y-1.5 text-ink-soft text-sm">
              {attention.later.map((plant) => (
                <li class="flex gap-3">
                  <span class="shrink-0 text-stone-400">·</span>
                  <span>
                    <a href={`/plants/${plant.id}`} class="text-terra hover:text-terra/80 font-medium transition-colors">{plant.data.name}</a>
                    {plant.data.nextAction && <span> — {plant.data.nextAction}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <ul class="hidden" data-task-pool>
        {poolRows.map(renderTaskRow)}
      </ul>
    </div>
    );
  })}
</Layout>

<script>
  // Re-place everything against the real current date on every load — builds
  // go stale between deploys. The placement rules live in lib/schedule.ts and
  // are shared with the build step above.
  import {
    MONTHS_LONG, todayFrom, placeTask, taskChip, deadlineKey, attentionChip, isWaiting,
  } from '../lib/schedule';

  const today = todayFrom();
  const CHIP_BASE = 'ml-1.5 align-middle text-[11px] font-semibold rounded px-1.5 py-0.5';
  const CHIP_CLASS: Record<string, string> = {
    urgent: 'bg-amber-50 text-amber-700',
    late: 'bg-red-50 text-red-700',
    muted: 'bg-stone-100 text-stone-500',
  };
  const setChip = (el: HTMLElement | null, chip: { text: string; tone: string } | null) => {
    if (!el) return;
    el.className = chip ? `${CHIP_BASE} ${CHIP_CLASS[chip.tone]}` : 'hidden';
    el.textContent = chip?.text ?? '';
  };

  // Live Melbourne weather: last fortnight's rain + week ahead, with hints for
  // the weather-gated jobs (early irrigation-on, deep watering, frost).
  const weatherBox = document.querySelector<HTMLElement>('[data-weather]');
  if (weatherBox) {
    fetch('https://api.open-meteo.com/v1/forecast?latitude=-37.81&longitude=144.96&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&past_days=14&forecast_days=7&timezone=Australia%2FMelbourne')
      .then((r) => r.json())
      .then((data) => {
        const { time, temperature_2m_max: mx, temperature_2m_min: mn, precipitation_sum: pr } = data.daily;
        const T = 14; // past_days=14 → index 14 is today
        const pastRain = pr.slice(0, T).reduce((a: number, b: number) => a + (b || 0), 0);
        const el = (sel: string) => weatherBox.querySelector<HTMLElement>(sel);
        el('[data-weather-past]')!.textContent = `${Math.round(pastRain)}mm rain in the last fortnight`;
        el('[data-weather-updated]')!.textContent = 'live · open-meteo';
        const daysEl = el('[data-weather-days]')!;
        for (let i = T; i < time.length; i++) {
          const d = new Date(time[i] + 'T12:00:00');
          const label = i === T ? 'Today' : d.toLocaleDateString('en-AU', { weekday: 'short' });
          const chip = document.createElement('span');
          chip.className = 'bg-stone-100 text-stone-600 rounded px-2 py-1 font-medium';
          const rain = (pr[i] ?? 0) >= 1 ? ` · ${Math.round(pr[i])}mm` : '';
          chip.textContent = `${label} ${Math.round(mn[i])}–${Math.round(mx[i])}°${rain}`;
          daysEl.appendChild(chip);
        }
        const weekRain = pr.slice(T).reduce((a: number, b: number) => a + (b || 0), 0);
        const warmDays = mx.slice(T).filter((v: number) => v >= 24).length;
        const hint = el('[data-weather-hint]')!;
        const hints: string[] = [];
        if (mn.slice(T).some((v: number) => v <= 2)) hints.push('Frost risk this week — leave frost-touched growth alone, it protects what\'s beneath.');
        if (warmDays >= 3 && weekRain < 5) hints.push('Warm dry stretch ahead — deep-water weather. If irrigation isn\'t on yet, this is the "turn it on early" trigger.');
        else if (mx.slice(T).some((v: number) => v >= 32)) hints.push('30°+ day coming — deep-water anything recently planted the evening before.');
        if (weekRain >= 20) hints.push(`Proper rain coming (~${Math.round(weekRain)}mm) — skip any watering plans.`);
        if (hints.length) { hint.textContent = hints.join(' '); hint.classList.remove('hidden'); }
        weatherBox.classList.remove('hidden');
      })
      .catch(() => {});
  }

  document.querySelectorAll<HTMLElement>('[data-dash-group]').forEach((group) => {
    const nowList = group.querySelector<HTMLElement>('[data-now-list]');
    const tasksNowList = group.querySelector<HTMLElement>('[data-tasks-now-list]');
    const pool = group.querySelector<HTMLElement>('[data-task-pool]');
    if (!nowList || !tasksNowList || !pool) return;

    const heading = group.querySelector('[data-month-heading]');
    if (heading) heading.textContent = MONTHS_LONG[today.month - 1];

    group.querySelectorAll<HTMLElement>('[data-attention-item]').forEach((li) => {
      const item = { readyFrom: li.dataset.readyFrom || undefined, dueBy: li.dataset.dueBy || undefined };
      li.hidden = isWaiting(item, today);
      setChip(li.querySelector<HTMLElement>('[data-chip]'), attentionChip(item, today));
    });

    const taskOf = (li: HTMLElement) => ({
      months: (li.dataset.months ?? '').split(',').map(Number),
      day: Number(li.dataset.day ?? 0) || undefined,
      byDay: Number(li.dataset.byDay ?? 0) || undefined,
      completed: li.dataset.completed || undefined,
      repeat: li.dataset.repeat === 'monthly' ? ('monthly' as const) : undefined,
    });

    group.querySelectorAll<HTMLElement>('[data-task-row]').forEach((li) => {
      const task = taskOf(li);
      const placement = placeTask(task, today);
      const dest = placement === 'now' ? tasksNowList : pool;
      if (li.parentElement !== dest) dest.appendChild(li);
      if (placement === 'now') setChip(li.querySelector<HTMLElement>('[data-task-chip]'), taskChip(task, placement, today));
    });

    // Most urgent first: real deadline (window close + byDay) soonest to the top
    [...tasksNowList.children]
      .sort((a, b) => deadlineKey(taskOf(a as HTMLElement), today) - deadlineKey(taskOf(b as HTMLElement), today))
      .forEach((el) => tasksNowList.appendChild(el));

    // Section visibility + counts against real placement
    const nowCount = [...nowList.children].filter((el) => !(el as HTMLElement).hidden).length + tasksNowList.children.length;
    group.querySelector('[data-now-section]')?.classList.toggle('hidden', nowCount === 0);
    group.querySelector('[data-todo-box]')?.classList.toggle('hidden', nowCount === 0);
    group.querySelector('[data-empty-state]')?.classList.toggle('hidden', nowCount > 0);
    const headerCount = group.querySelector('[data-header-count]');
    if (headerCount) headerCount.textContent = String(tasksNowList.children.length);
  });
</script>
