---
import Layout from '../layouts/layout.astro';
import Photo from '../components/Photo.astro';

type Mark =
  | { kind: 'pin'; n: number; x: number; y: number; tone: 'act' | 'id' | 'leave'; text: string }
  | { kind: 'ring'; n: number; x: number; y: number; r: number; tone: 'act' | 'id' | 'leave'; text: string }
  | { kind: 'cutline'; y: number; tilt?: number; tag: string; text: string };

interface Plate {
  img: string;
  ratio: string;
  section: string;
  title: string;
  intro: string;
  marks: Mark[];
  foot?: string;
}

const PLATES: Plate[] = [
  {
    img: '/images/spring-2026/IMG_4367.jpg',
    ratio: '3/4',
    section: 'Hose path',
    title: 'Where the hose cuts through the back bed',
    intro: 'The hose runs from the lawn to the back fence in a straight line, and the straight line goes through three plants. Two posts make it go round instead.',
    marks: [
      { kind: 'ring', n: 1, x: 36, y: 63, r: 15, tone: 'id', text: 'Yellow buttons (the dusty miller card): split open and pressed flat along the hose line. Healthy, stands back up once the hose stops crossing it.' },
      { kind: 'pin', n: 2, x: 50, y: 80, tone: 'act', text: 'Post one: at the bed corner where the lawn meets the stepping stones. The hose pivots here and stays on the stones.' },
      { kind: 'pin', n: 3, x: 62, y: 46, tone: 'act', text: 'Post two: beside the needle-leaf shrub, on the path side. Keeps the hose off its skirt and out of the sage behind it.' },
    ],
    foot: 'Pull the hose round the outside of both posts every time. Any hose guide or hardwood stake does the job.',
  },
  {
    img: '/images/spring-2026/IMG_4352.jpg',
    ratio: '3/4',
    section: 'Hose path',
    title: 'The same hose, further along, through the sage',
    intro: 'Past the needle-leaf shrub the hose dives under the Mexican sage and comes out on the paving.',
    marks: [
      { kind: 'pin', n: 1, x: 21, y: 20, tone: 'id', text: 'Hose enters between the sage and the citrus.' },
      { kind: 'pin', n: 2, x: 13, y: 58, tone: 'id', text: 'Runs under the lawn-side edge of the mound. Stems on this side get bent and snapped each time it is dragged.' },
      { kind: 'ring', n: 3, x: 52, y: 55, r: 30, tone: 'leave', text: 'The sage itself: healthy, leave it. Post two on the plate above fixes this stretch too.' },
    ],
  },
  {
    img: '/images/spring-2026/IMG_4344.jpg',
    ratio: '4/3',
    section: 'Foot traffic',
    title: 'Lawn wear spots',
    intro: 'The lawn is the greenest it has been this year. The bare soil that is left sits exactly where feet land.',
    marks: [
      { kind: 'ring', n: 1, x: 74, y: 47, r: 9, tone: 'act', text: 'Under the hoop: move the hoop a couple of metres along the roller door each mow so this spot rests and the runners close in.' },
      { kind: 'ring', n: 2, x: 45, y: 50, r: 10, tone: 'leave', text: 'Strip in front of the raised beds: the run between the deck and the side path. It thins and recovers with use. No pegging while it is being walked on.' },
    ],
  },
  {
    img: '/images/spring-2026/IMG_4364.jpg',
    ratio: '3/4',
    section: 'Foot traffic',
    title: 'The side path pinch point',
    intro: 'Everyone going down the side squeezes between the raised bed and the stepping stones.',
    marks: [
      { kind: 'pin', n: 1, x: 43, y: 12, tone: 'leave', text: 'Side path: worn to a dirt track. It is the walkway, leave it.' },
      { kind: 'ring', n: 2, x: 12, y: 60, r: 10, tone: 'leave', text: 'Lawn edge worn thin by the turn onto the stepping stones.' },
      { kind: 'pin', n: 3, x: 30, y: 62, tone: 'id', text: 'Bed wall bowed out of shape on the walking side, from being leaned and stepped on. Cosmetic.' },
      { kind: 'pin', n: 4, x: 52, y: 78, tone: 'id', text: 'Irrigation pipe lifted out and sitting loose on the mulch. Drippers still reach the plants.' },
    ],
  },
  {
    img: '/images/spring-2026/IMG_4375.jpg',
    ratio: '3/4',
    section: 'Check this plant',
    title: 'Needle mat under the gymea',
    intro: 'Whorls of flat green needles on wiry stems, spreading across the bark. It looks like asparagus fern, a weed that comes back from tubers.',
    marks: [
      { kind: 'ring', n: 1, x: 31, y: 63, r: 21, tone: 'act', text: 'Push a finger under the mat. White grape-size tubers on the roots, or small thorns on the stems = asparagus fern: fork out the crown and every tuber, red bin. Neither = leave it.' },
      { kind: 'pin', n: 2, x: 60, y: 45, tone: 'leave', text: 'The gymea: healthy. Work round its base, do not lever against it.' },
    ],
    foot: 'A second small tuft sits a metre away, in front of the kangaroo paws.',
  },
];

const sections = [...new Set(PLATES.map((p) => p.section))];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];


const TONE = {
  act: { dot: 'bg-terra text-white', ring: 'border-terra', chip: 'bg-terra text-white' },
  id: { dot: 'bg-olive text-white', ring: 'border-olive', chip: 'bg-olive text-white' },
  leave: { dot: 'bg-ink-soft text-white', ring: 'border-ink-soft', chip: 'bg-ink-soft text-white' },
};
---

<Layout title="Field Notes — Garden">
  <div class="animate-in">
    <div class="mb-10">
      <p class="font-medium text-terra uppercase tracking-widest text-sm mb-1">Annotated photos · open jobs only</p>
      <h1 class="text-4xl font-semibold mb-2">Field Notes</h1>
      <p class="text-ink-soft max-w-2xl">
        The garden, marked up — where to cut, what each thing is, what to leave alone.
        <span class="text-terra font-medium">Terracotta</span> marks mean act,
        <span class="text-olive font-medium">olive</span> marks identify,
        grey marks mean hands off. Pin positions are approximate — read the note, then find the spot in front of you.
      </p>
      <p class="mt-3 text-sm"><a href="/photo-audit" class="text-terra font-medium hover:underline">Winter 2026 baseline photos</a> <span class="text-ink-faint">— 51 shots, the before set for the spring comparison</span></p>
    </div>

    {sections.length === 0 && (
      <p class="font-display italic text-ink-faint text-xl">Nothing marked up right now. Plates appear here when a job needs a photo to explain it, and come down once it's done.</p>
    )}

    {sections.map((section) => (
      <section class="mb-14">
        <h2 class="font-display text-3xl font-semibold mb-5 pb-2 border-b border-rule">{section}</h2>
        <div class="space-y-10">
          {PLATES.filter((p) => p.section === section).map((plate) => {
            const idx = PLATES.indexOf(plate);
            return (
              <figure class="bg-paper rounded-xl border border-rule overflow-hidden">
                <div class="px-5 pt-4 pb-3">
                  <p class="font-display italic text-ink-faint text-lg leading-none mb-1">Plate {roman[idx]}</p>
                  <h3 class="font-display text-2xl font-semibold mb-1.5">{plate.title}</h3>
                  <p class="text-ink-soft text-[0.97rem] max-w-2xl">{plate.intro}</p>
                </div>

                <div class="px-5">
                  <div class="relative rounded-lg overflow-hidden border border-rule-light" style={`aspect-ratio: ${plate.ratio};`}>
                    <Photo src={plate.img} alt={plate.title} widths={[720, 1440]} sizes="(min-width: 1024px) 60rem, 100vw" class="absolute inset-0 w-full h-full object-cover" />

                    {plate.marks.map((m) => {
                      if (m.kind === 'cutline') {
                        return (
                          <div class="absolute left-0 right-0" style={`top: ${m.y}%; transform: rotate(${m.tilt ?? 0}deg);`}>
                            <div class="border-t-2 border-dashed border-terra/95 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]"></div>
                            <span class="absolute right-2 -top-3.5 -translate-y-1/2 bg-terra text-white text-xs font-semibold px-2.5 py-1 rounded-full shadow-md whitespace-nowrap">
                              ✂ {m.tag}
                            </span>
                          </div>
                        );
                      }
                      if (m.kind === 'ring') {
                        return (
                          <div
                            class:list={['absolute rounded-full border-[3px] shadow-[0_0_0_1.5px_rgba(255,255,255,0.85),inset_0_0_0_1.5px_rgba(255,255,255,0.85)]', TONE[m.tone].ring]}
                            style={`left: ${m.x - m.r}%; top: ${m.y - m.r * (plate.ratio === '4/3' ? 4 / 3 : 3 / 4)}%; width: ${m.r * 2}%; aspect-ratio: 1;`}
                          >
                            <span class:list={['absolute -top-2 -right-2 w-6 h-6 rounded-full text-xs font-bold flex items-center justify-center shadow-md', TONE[m.tone].dot]}>{m.n}</span>
                          </div>
                        );
                      }
                      return (
                        <span
                          class:list={['absolute w-6 h-6 -ml-3 -mt-3 rounded-full text-xs font-bold flex items-center justify-center shadow-[0_0_0_2px_rgba(255,255,255,0.9),0_2px_5px_rgba(0,0,0,0.45)]', TONE[m.tone].dot]}
                          style={`left: ${m.x}%; top: ${m.y}%;`}
                        >{m.n}</span>
                      );
                    })}
                  </div>
                </div>

                <figcaption class="px-5 py-4">
                  <ul class="space-y-2">
                    {plate.marks.map((m) =>
                      m.kind === 'cutline' ? (
                        <li class="flex gap-3 items-baseline">
                          <span class="shrink-0 bg-terra text-white text-xs font-semibold px-2 py-0.5 rounded-full">✂ cut line</span>
                          <span class="text-[0.95rem] text-ink-soft">{m.text}</span>
                        </li>
                      ) : (
                        <li class="flex gap-3 items-baseline">
                          <span class:list={['shrink-0 w-5 h-5 rounded-full text-[0.7rem] font-bold flex items-center justify-center translate-y-0.5', TONE[m.tone].dot]}>{m.n}</span>
                          <span class="text-[0.95rem] text-ink-soft">{m.text}</span>
                        </li>
                      )
                    )}
                  </ul>
                  {plate.foot && (
                    <p class="mt-3 pt-3 border-t border-rule-light text-[0.9rem] text-ink-faint italic font-display text-base">{plate.foot}</p>
                  )}
                </figcaption>
              </figure>
            );
          })}

        </div>
      </section>
    ))}
  </div>
</Layout>
