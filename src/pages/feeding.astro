---
import Layout from '../layouts/layout.astro';
import { FEEDING_PLAN, FEEDING_SKIPS, FEEDING_YEAR, getCurrentMonth } from '../lib/utils';

const currentMonth = getCurrentMonth();
// "You are here" sits on the round that includes this month, or else the next one coming up.
const distance = (months: number[]) => Math.min(...months.map((m) => (m - currentMonth + 12) % 12));
const hereIndex = FEEDING_YEAR.reduce((best, entry, i) => (distance(entry.months) < distance(FEEDING_YEAR[best].months) ? i : best), 0);
---

<Layout title="Feeding Guide — Garden">
  <div class="animate-in">
    <!-- Header -->
    <div class="mb-10">
      <p class="font-medium text-terra uppercase tracking-widest text-sm mb-1">Quick reference</p>
      <h1 class="text-4xl font-semibold mb-3">The Feeding Guide</h1>
      <p class="text-ink-soft max-w-2xl">
        Four products, every plant assigned, nothing to remember. Find the product you're
        holding, feed what's on its label, skip what's in the skip list. The year timeline
        at the bottom says when.
      </p>
    </div>

    <!-- Product labels -->
    <div class="grid md:grid-cols-2 gap-5 mb-12">
      {FEEDING_PLAN.map((product) => (
        <section class="bg-paper rounded-xl border border-rule overflow-hidden flex flex-col">
          <div class={`h-1.5 ${product.accent}`}></div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-baseline justify-between gap-3 mb-0.5">
              <h2 class="font-display text-2xl font-semibold">{product.name}</h2>
            </div>
            <p class="text-sm font-medium text-terra mb-3">Apply: {product.timing}</p>
            <div class="space-y-3">
              {product.groups.map((group) => (
                <div>
                  <p class="text-xs uppercase tracking-widest text-ink-faint mb-1.5">{group.dose}</p>
                  <div class="flex flex-wrap gap-1.5">
                    {group.plants.map((plant) => (
                      <span class={`px-2.5 py-1 rounded-full text-sm font-medium ${product.chip}`}>{plant}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            {product.note && (
              <p class="text-sm text-ink-soft mt-4 pt-3 border-t border-rule-light">{product.note}</p>
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- Skip list -->
    <section class="mb-12 bg-paper rounded-xl border border-rule p-5">
      <h2 class="font-display text-2xl font-semibold mb-3">Feed nothing to these</h2>
      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2">
        {FEEDING_SKIPS.map(({ plant, reason }) => (
          <li class="flex gap-2.5 items-baseline">
            <span class="w-1.5 h-1.5 rounded-full bg-terra shrink-0 translate-y-[-2px]"></span>
            <span><strong class="font-semibold">{plant}</strong> <span class="text-ink-soft">— {reason}</span></span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Year at a glance -->
    <section class="mb-8">
      <h2 class="font-display text-2xl font-semibold mb-4">The feeding year</h2>
      <ol class="relative border-l-2 border-rule ml-2 space-y-6">
        {FEEDING_YEAR.map((entry, i) => (
          <li class="pl-6 relative">
            <span class={`absolute -left-[7px] top-1.5 w-3 h-3 rounded-full ${i === hereIndex ? 'bg-terra' : 'bg-rule'}`}></span>
            <p class="text-xs uppercase tracking-widest text-ink-faint">{entry.when}</p>
            <p class="font-display text-xl font-semibold">
              {entry.label}
              {i === hereIndex && <span class="ml-2 text-sm font-body font-medium text-terra">← next up</span>}
            </p>
            <p class="text-ink-soft max-w-xl">{entry.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <p class="text-sm text-ink-faint border-t border-rule-light pt-4">
      One rule outranks everything on this page: natives get the native food and nothing else.
    </p>
  </div>
</Layout>
