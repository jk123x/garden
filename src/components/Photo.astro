---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src?: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  widths = [480, 960],
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  class: cls,
  loading = 'lazy',
} = Astro.props;

const meta = await resolveImage(src);
---

{meta ? (
  <Image
    src={meta}
    alt={alt}
    widths={widths}
    width={Math.max(...widths)}
    sizes={sizes}
    format="webp"
    quality={72}
    class={cls}
    loading={loading}
    decoding="async"
  />
) : (
  <div class:list={['bg-rule-light', cls]} aria-hidden="true"></div>
)}
